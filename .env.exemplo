# Copie este arquivo para .env e preencha. NUNCA envie o .env para o GitHub.

# Endereço do sistema (o domínio precisa apontar para o IP do servidor).
DOMINIO=erp.suaempresa.com.br
DJANGO_ALLOWED_HOSTS=erp.suaempresa.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.suaempresa.com.br

# Chave secreta: gere uma com o comando abaixo e cole aqui.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Banco de dados. Use uma senha longa e aleatória.
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=

# Produção.
DJANGO_DEBUG=false

# Quantos dias de backup manter em ./backups
BACKUP_DIAS=14
